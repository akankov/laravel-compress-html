{
  // Mutation testing config. Run via `make infection` (needs a coverage driver:
  // pcov or xdebug). The MSI thresholds are passed on the CLI by the Makefile
  // and enforced in the CI coverage job.
  $schema: "vendor/infection/infection/resources/schema.json",
  source: {
    directories: ["src"],
  },
  // Keep Infection's transient files out of the repo root (under the
  // already-ignored build/ tree).
  tmpDir: "build/infection",
  logs: {
    text: "build/infection/infection.log",
    summary: "build/infection/summary.log",
  },
  mutators: {
    "@default": true,
  },
}
